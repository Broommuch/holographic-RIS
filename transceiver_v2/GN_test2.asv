clc; clear; close all;

%% ================= 1. 参数 =================
N = 128;
d = 0.5;
theta_true = 30;
phi_true = 20;
theta_rad = deg2rad(theta_true);
phi_rad = deg2rad(phi_true);
u_true = sin(theta_rad)*cos(phi_rad);
v_true = sin(theta_rad)*sin(phi_rad);

[x_idx, y_idx] = meshgrid(0:N-1, 0:N-1);
cx = (N-1)/2; 
cy = (N-1)/2;

%% ================= 2. 构造目标场 =================
phase_true = 2*pi*d*((x_idx-cx)*u_true + (y_idx-cy)*v_true);
O_true = exp(1i * phase_true);

%% ================= 3. 参考光 =================
lambda = 633e-9;
pixel_size = 5e-6;
theta_x_ref = 2;      % 注意：原值为20会导致严重混叠，已调整为合理值
theta_y_ref = 1;      % 注意：原值为10，已调整为合理值
[X_idx, Y_idx] = meshgrid(0:N-1, 0:N-1);
X = (X_idx-cx)*pixel_size;
Y = (Y_idx-cy)*pixel_size;
R = exp(1i * 2*pi / lambda * (X .* sin(deg2rad(theta_x_ref)) + ...
                              Y .* sin(deg2rad(theta_y_ref))));
R = rand(N)

%% ================= 4. 测量 =================
I = abs(O_true + R).^2;

%% ================= 5. GN/LM 初始化 =================
u = 0.49;          % 比原来更接近真值，加快收敛
v = 0.19;
lambda_damp = 1;  % LM初始阻尼（自适应调整）
num_iter = 100;
cost_history = zeros(1, num_iter);

figure('Position', [100 100 1200 500]);

%% ================= 6. Levenberg-Marquardt (改进的Gauss-Newton) =================
for iter = 1:num_iter
    % 当前模型
    phase = 2*pi*d*((x_idx-cx)*u + (y_idx-cy)*v);
    O = exp(1i * phase);
    Z = O + R;
    Z_conj = conj(Z);
    
    % 残差
    r = abs(Z).^2 - I;
    r_vec = r(:);
    cost = r_vec'*r_vec;
    cost_history(iter) = cost;
    
    % ===== Jacobian =====
    dO_du = 1i * 2*pi*d*(x_idx-cx) .* O;
    dO_dv = 1i * 2*pi*d*(y_idx-cy) .* O;
    J_u = 2 * real(dO_du .* Z_conj);
    J_v = 2 * real(dO_dv .* Z_conj);
    J = [J_u(:), J_v(:)];   % N^2 × 2
    
    % ===== LM 更新（H + lambda*I）=====
    H = J'*J;
    g = J'*r_vec;
    delta = -(H + lambda_damp*eye(2)) \ g;
    
    % 试探步
    u_new = u + delta(1);
    v_new = v + delta(2);
    phase_new = 2*pi*d*((x_idx-cx)*u_new + (y_idx-cy)*v_new);
    O_new = exp(1i * phase_new);
    Z_new = O_new + R;
    r_new = abs(Z_new).^2 - I;
    cost_new = sum(r_new(:).^2);
    
    % 接受/拒绝 + 自适应阻尼
    if cost_new < cost * (1 - 1e-6)
        u = u_new;
        v = v_new;
        lambda_damp = max(lambda_damp * 0.1, 1e-10);  % 成功，减小阻尼
        fprintf('Iter %3d: u=%.6f, v=%.6f, cost=%.2e → %.2e (ACCEPTED, lambda=%.2e)\n', ...
                iter, u, v, cost, cost_new, lambda_damp);
    else
        lambda_damp = lambda_damp * 10;               % 失败，增大阻尼
        if lambda_damp > 1e8
            fprintf('Iter %3d: 阻尼过大，提前终止\n', iter);
            break;
        end
        fprintf('Iter %3d: u=%.6f, v=%.6f, cost=%.2e (REJECTED, lambda=%.2e)\n', ...
                iter, u, v, cost, lambda_damp);
    end
    
    % ===== 显示（始终使用当前最优u,v）=====
    phase = 2*pi*d*((x_idx-cx)*u + (y_idx-cy)*v);  % 重新计算当前最优O
    O = exp(1i * phase);
    
    subplot(1,2,1);
    imagesc(angle(O)); axis image; colorbar;
    title(['恢复相位 iter=' num2str(iter)]);
    
    subplot(1,2,2);
    phase_err = angle(O .* conj(O_true));
    imagesc(phase_err); axis image; colorbar; caxis([-pi pi]);
    title('相位误差');
    drawnow;
    
    % 收敛判断
    if norm(delta) < 1e-8
        fprintf('=== 已收敛于第 %d 迭代 ===\n', iter);
        break;
    end
end

%% ================= 7. 结果对比 =================
fprintf('\n=== 最终结果 ===\n');
fprintf('真实: u=%.6f, v=%.6f\n', u_true, v_true);
fprintf('估计: u=%.6f, v=%.6f\n', u, v);
fprintf('最终相位误差 RMS = %.6f rad\n', sqrt(mean(phase_err(:).^2)));

figure;
imagesc(angle(O .* conj(O_true)));
axis image; colorbar; caxis([-pi pi]);
title('最终相位误差');